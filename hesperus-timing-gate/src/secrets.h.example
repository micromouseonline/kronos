#pragma once

#include "board-role.h"

/// @file secrets.h
/// @brief WiFi credentials and other sensitive configuration.
///
/// Copy this file to secrets.h and fill in real values.
/// secrets.h is gitignored and must never be committed.

const char* ssid = "your_ssid_here";
const char* password = "your_password_here";

// Compile-time fallback role, for bench testing without running the `role`
// serial command after every flash. Same priority as ssid/password above --
// only used when NVS has no role saved yet (see board_role_load() in
// main.cpp's setup()); `role start`/`role goal` on the serial console still
// overrides it. Leave as BoardRole::UNSET for boards provisioned entirely
// over serial.
constexpr BoardRole DEFAULT_BOARD_ROLE = BoardRole::UNSET;

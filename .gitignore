# PlatformIO build artefacts (all sub-projects)
**/.pio/

# Merged release binaries - published via GitHub Releases, not tracked here
**/dist/

# VSCode workspace settings (keep .code-workspace, ignore local overrides)
**/.vscode/settings.json
**/.vscode/*.log
**/.vscode/extensions.json

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Secrets - never commit
**/secrets.h
**/*.key
**/*.pem

# KiCad cache/backup cruft (hardware/pcb/)
**/*-backups/
**/*.kicad_prl
**/fp-info-cache
**/_autosave-*
# KiCad local history snapshots (a nested git repo KiCad manages itself)
**/.history/
# KiCad "file is open" lock files
**/~*.lck

# FreeCAD backup files (hardware/mechanical/)
**/*.FCBak
**/*.FCStd1

# EEZ Studio per-user editor layout state
**/*.eez-project-ui-state

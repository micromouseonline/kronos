# PlatformIO build artefacts (all sub-projects)
**/.pio/

# Merged release binaries - published via GitHub Releases, not tracked here
**/dist/

# VSCode workspace settings (keep .code-workspace, ignore local overrides)
**/.vscode/settings.json
**/.vscode/*.log

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Secrets - never commit
**/secrets.h
**/*.key
**/*.pem

# KiCad cache/backup cruft (hardware/pcb/)
**/*-backups/
**/*.kicad_prl
**/fp-info-cache
**/_autosave-*

# FreeCAD backup files (hardware/mechanical/)
**/*.FCBak
**/*.FCStd1
